---
import CtaBand from "../components/CtaBand.astro";
import FacilityList from "../components/FacilityList.astro";
import LocationCard from "../components/LocationCard.astro";
import PageHero from "../components/PageHero.astro";
import TeamCard from "../components/TeamCard.astro";
import { aboutIntro, aboutSections } from "../content/about";
import { facilities } from "../content/facilities";
import { vehicles } from "../content/vehicles";
import { publishedLocations, visibleTeam } from "../lib/catalogue";
import { pageCrumbs } from "../lib/links";
import BaseLayout from "../layouts/BaseLayout.astro";

const crumbs = pageCrumbs([{ label: "About", href: "/about/" }]);
---

<BaseLayout
  title="About us"
  description="Webco Professional provides HGV and transport training: Category C, Category C+E, Driver CPC, ADR and Operator CPC, from bases in Bristol, Taunton and Exeter."
  crumbs={crumbs}
>
  <PageHero crumbs={crumbs} eyebrow={aboutIntro.eyebrow} title={aboutIntro.title} lede={aboutIntro.lede} />
  <div class="block block-follow">
    <div class="wrap measure">
      {
        aboutSections.map((section) => (
          <section class="about-section" aria-labelledby={section.id}>
            <h2 id={section.id}>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))
      }
    </div>
  </div>
  <section class="block band" aria-labelledby="facilities">
    <div class="wrap">
      <div class="section-head">
        <h2 id="facilities">Facilities and vehicles</h2>
        <p class="section-intro">The vehicles and facilities our bases use for practical and classroom training.</p>
      </div>
      <FacilityList facilities={facilities} vehicles={vehicles} />
    </div>
  </section>
  <section class="block" aria-labelledby="local">
    <div class="wrap">
      <div class="section-head">
        <h2 id="local">Where training runs</h2>
        <p class="section-intro">Three bases across Bristol, Somerset and Devon, each with its own local roads and routes.</p>
      </div>
      <ul class="cards">
        {publishedLocations().map((location) => <LocationCard location={location} />)}
      </ul>
    </div>
  </section>
  <section class="block band" aria-labelledby="team-preview">
    <div class="wrap">
      <div class="section-head">
        <h2 id="team-preview">Instructors</h2>
        <p class="section-intro">The teams who deliver our licence and classroom courses.</p>
      </div>
      <ul class="cards">
        {visibleTeam().map((person) => <TeamCard person={person} />)}
      </ul>
      <p class="section-more"><a href="/team/">Instructors and team</a></p>
    </div>
  </section>
  <section class="block" aria-labelledby="proof-link">
    <div class="wrap measure">
      <h2 id="proof-link">Learner feedback</h2>
      <p>Read what learners say about training with us.</p>
      <p><a href="/reviews/">Read learner feedback</a></p>
    </div>
  </section>
  <CtaBand title="Ask about training" lede="Tell us which course you want, and which base you prefer." />
</BaseLayout>
