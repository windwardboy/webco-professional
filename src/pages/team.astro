---
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import TeamCard from "../components/TeamCard.astro";
import { visibleTeam } from "../lib/catalogue";
import { pageCrumbs } from "../lib/links";
import BaseLayout from "../layouts/BaseLayout.astro";

const crumbs = pageCrumbs([{ label: "Team", href: "/team/" }]);
const people = visibleTeam();
---

<BaseLayout
  title="Instructors and team"
  description="The driving and classroom instructor teams behind our Category C, Category C+E, Driver CPC, ADR and Operator CPC courses."
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Our instructors"
    title="Instructors and team"
    lede="Our instructors deliver licence training and classroom courses from our bases in Bristol, Taunton and Exeter. The profiles below describe the role each team plays."
  />
  <div class="block block-follow">
    <div class="wrap">
      <ul class="cards">
        {people.map((person) => <TeamCard person={person} />)}
      </ul>
    </div>
  </div>
  <CtaBand title="Ask about training" lede="Tell us which course you are interested in, and which base you prefer." />
</BaseLayout>
