---
import PageHero from "../components/PageHero.astro";
import { faqsByTopic } from "../lib/catalogue";
import { pageCrumbs } from "../lib/links";
import BaseLayout from "../layouts/BaseLayout.astro";

const crumbs = pageCrumbs([{ label: "FAQs", href: "/faqs/" }]);
const topics = faqsByTopic();
---

<BaseLayout
  title="FAQs"
  description="Answers to common questions about HGV licences, medicals, theory and practical tests, prices and how to enquire."
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="FAQs"
    title="Questions about HGV training"
    lede="Licences, medicals, the practical test, prices and how to get started."
  />
  {
    topics.map((topic, index) => (
      <section class:list={["block", "faq", index % 2 === 1 && "band"]} aria-labelledby={topic.id}>
        <div class="wrap">
          <div class="section-head">
            <h2 id={topic.id}>{topic.label}</h2>
          </div>
          <div class="faq-list">
            {topic.items.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>
