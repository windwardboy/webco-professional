---
import EnquiryForm from "../components/EnquiryForm.astro";
import MapPlaceholder from "../components/MapPlaceholder.astro";
import PageHero from "../components/PageHero.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import { publishedLocations } from "../content/locations";
import { afterEnquiry } from "../content/process";
import { site } from "../config/site";
import { hasMultipleLocations } from "../lib/catalogue";
import { httpsUrl, pageCrumbs } from "../lib/links";
import BaseLayout from "../layouts/BaseLayout.astro";

const crumbs = pageCrumbs([{ label: "Contact", href: "/contact/" }]);
const mapUrl = httpsUrl(site.mapEmbedUrl);
---

<BaseLayout
  title="Contact"
  description="Enquire about HGV training with Webco Professional. Call, email or use the enquiry form to ask about courses at our Bristol, Taunton and Exeter bases."
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Contact"
    title="Contact"
    lede="Tell us which course you are interested in, which base you prefer and how you would like to be contacted. We will reply using the method you choose."
  />
  <div class="block block-follow">
    <div class="wrap contact-layout">
      <div>
        <h2 id="enquiry">Enquiry</h2>
        <div class="enquiry-offset">
          <EnquiryForm />
        </div>
      </div>
      <div class="contact-card">
        <h2>Phone and email</h2>
        <ul class="contact-list">
          <li>
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
            <span class="example-tag">Sample number</span>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <span class="example-tag">Sample email</span>
          </li>
          {
            site.showWhatsApp ? (
              <li>
                <a href={site.whatsappHref} rel="noopener noreferrer">WhatsApp {site.whatsappDisplay}</a>
                <span class="example-tag">Sample number</span>
              </li>
            ) : null
          }
        </ul>
        <h2>Training bases</h2>
        <p>We send the site address and joining details once your course is agreed.</p>
        <ul class="contact-list">
          {
            publishedLocations().map((location) => (
              <li>
                <a href={`/locations/${location.slug}/`}>{location.name}</a>
                <span class="example-tag">Sample location</span>
              </li>
            ))
          }
        </ul>
        <h2>Hours</h2>
        <ul class="contact-list">
          {
            site.hours.map((row) => (
              <li>
                {row.label}: {row.value}
                <span class="example-tag">Sample hours</span>
              </li>
            ))
          }
        </ul>
        <p class="example-caption">{site.hoursNote}</p>
      </div>
    </div>
  </div>
  <section class="block band" aria-labelledby="map-heading">
    <div class="wrap">
      <h2 id="map-heading">Finding your base</h2>
      {
        mapUrl ? (
          <iframe class="map-frame" title="Training location map" src={mapUrl} loading="lazy" referrerpolicy="no-referrer"></iframe>
        ) : (
          <MapPlaceholder />
        )
      }
    </div>
  </section>
  <section class="block" aria-labelledby="areas">
    <div class="wrap measure">
      <h2 id="areas">Areas served</h2>
      <p>{site.areasNote}</p>
      <ul class="prose-list">
        {site.areasServed.map((area) => <li>{area} base</li>)}
      </ul>
      {
        hasMultipleLocations() ? null : (
          <p>Training is arranged from one base.</p>
        )
      }
    </div>
  </section>
  <ProcessSteps id="next" title="What happens next" steps={afterEnquiry} band={true} />
</BaseLayout>
