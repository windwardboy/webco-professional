---
interface Props {
  label?: string;
}

const { label = "Example location. No address and no map pin are shown." } = Astro.props;
---

<div class="map-placeholder" role="img" aria-label={label}>
  <p class="map-placeholder-title">No map</p>
  <p>Example location. No address and no map pin are shown.</p>
</div>
