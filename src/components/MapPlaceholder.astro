---
interface Props {
  label?: string;
}

const { label = "Directions are sent with your course confirmation." } = Astro.props;
---

<div class="map-placeholder" role="img" aria-label={label}>
  <p class="map-placeholder-title">Directions</p>
  <p>The site address, a map and joining instructions are sent with your course confirmation.</p>
</div>
