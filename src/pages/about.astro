---
import CtaBand from "../components/CtaBand.astro";
import FacilityList from "../components/FacilityList.astro";
import LocationCard from "../components/LocationCard.astro";
import PageHero from "../components/PageHero.astro";
import TeamCard from "../components/TeamCard.astro";
import { aboutIntro, aboutSections } from "../content/about";
import { facilities } from "../content/facilities";
import { vehicles } from "../content/vehicles";
import { publishedLocations, visibleTeam } from "../lib/catalogue";
import { pageCrumbs } from "../lib/links";
import BaseLayout from "../layouts/BaseLayout.astro";

const crumbs = pageCrumbs([{ label: "About", href: "/about/" }]);
---

<BaseLayout
  title="About"
  description="About this HGV training demonstration: the courses, the example bases, and what is not claimed. No accreditation or pass rate is shown."
  crumbs={crumbs}
>
  <PageHero crumbs={crumbs} eyebrow={aboutIntro.eyebrow} title={aboutIntro.title} lede={aboutIntro.lede} />
  <div class="block block-follow">
    <div class="wrap measure">
      {
        aboutSections.map((section) => (
          <section class="about-section" aria-labelledby={section.id}>
            <h2 id={section.id}>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))
      }
    </div>
  </div>
  <section class="block band" aria-labelledby="facilities">
    <div class="wrap">
      <div class="section-head">
        <h2 id="facilities">Facilities and vehicles</h2>
        <p class="section-intro">Examples only. No yard, make or fleet size is named.</p>
      </div>
      <FacilityList facilities={facilities} vehicles={vehicles} />
    </div>
  </section>
  <section class="block" aria-labelledby="local">
    <div class="wrap">
      <div class="section-head">
        <h2 id="local">Where training runs</h2>
        <p class="section-intro">Three example bases. Nearby towns are not given their own pages.</p>
      </div>
      <ul class="cards">
        {publishedLocations().map((location) => <LocationCard location={location} />)}
      </ul>
    </div>
  </section>
  <section class="block band" aria-labelledby="team-preview">
    <div class="wrap">
      <div class="section-head">
        <h2 id="team-preview">Instructors</h2>
        <p class="section-intro">Example profiles. No name or qualification is shown.</p>
      </div>
      <ul class="cards">
        {visibleTeam().map((person) => <TeamCard person={person} />)}
      </ul>
      <p class="section-more"><a href="/team/">Team page</a></p>
    </div>
  </section>
  <section class="block" aria-labelledby="proof-link">
    <div class="wrap measure">
      <h2 id="proof-link">Learner feedback</h2>
      <p>The reviews on this site are examples. No rating is shown.</p>
      <p><a href="/reviews/">Read the reviews page</a></p>
    </div>
  </section>
  <CtaBand title="Ask about training" lede="Say which course you want, and which example base you prefer." />
</BaseLayout>
