---
import CtaBand from "../components/CtaBand.astro";
import LearnerProof from "../components/LearnerProof.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";
import { testimonials } from "../lib/catalogue";
import { httpsUrl, pageCrumbs } from "../lib/links";
import BaseLayout from "../layouts/BaseLayout.astro";

const crumbs = pageCrumbs([{ label: "Reviews", href: "/reviews/" }]);
const reviewsUrl = httpsUrl(site.googleReviewsUrl);
---

<BaseLayout
  title="Reviews"
  description="Learner feedback on Category C, Category C+E, Driver CPC and ADR training at our Bristol, Taunton and Exeter bases."
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Learner feedback"
    title="Reviews"
    lede="What learners say about training at our Bristol, Taunton and Exeter bases. The comments below are sample reviews for this demonstration."
  />
  <LearnerProof id="quotes" title="What learners say" items={testimonials} />
  <section class="block band" aria-labelledby="external-reviews">
    <div class="wrap measure">
      <h2 id="external-reviews">{reviewsUrl ? "Google reviews" : "Your feedback"}</h2>
      {
        reviewsUrl ? (
          <p>
            <a href={reviewsUrl}>Read the reviews on Google</a>
          </p>
        ) : (
          <p>
            If you have trained with us, we would like to hear how it went. <a href="/contact/">Get in touch</a> and tell us what worked and what we could do better.
          </p>
        )
      }
    </div>
  </section>
  <CtaBand title="Ask about training" lede="Tell us which course you want, or say that you are not sure yet." />
</BaseLayout>
