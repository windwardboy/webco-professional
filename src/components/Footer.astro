---
import { site } from "../config/site";
import { additionalCourses, coreCourses, featuredGuides, publishedLocations } from "../lib/catalogue";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-about">
      <a class="footer-logo" href="/" aria-label={site.name}>
        <img class="logo-full" src="/logo-reversed.svg" width="180" height="62" alt="" />
      </a>
      <p>{site.demoLine}. {site.footerSummary}</p>
      {
        site.webcoMediaUrl ? (
          <p>
            <a href={site.webcoMediaUrl}>Webco Media</a>
          </p>
        ) : (
          <p>Webco Media</p>
        )
      }
    </div>
    <div>
      <p class="footer-label">Training</p>
      <ul class="footer-nav">
        <li><a href="/hgv-training/">HGV training</a></li>
        {
          coreCourses().map((course) => (
            <li>
              <a href={course.path}>{course.navLabel}</a>
            </li>
          ))
        }
        {
          additionalCourses().map((course) => (
            <li>
              <a href={course.path}>{course.navLabel}</a>
            </li>
          ))
        }
        <li><a href="/training/">All training</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Locations</p>
      <ul class="footer-nav">
        {
          publishedLocations().map((location) => (
            <li>
              <a href={`/locations/${location.slug}/`}>{location.name}</a>
            </li>
          ))
        }
        <li><a href="/about/">About</a></li>
        <li><a href="/team/">Team</a></li>
        <li><a href="/reviews/">Reviews</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Guides</p>
      <ul class="footer-nav">
        {
          featuredGuides().map((guide) => (
            <li>
              <a href={guide.path}>{guide.title}</a>
            </li>
          ))
        }
        <li><a href="/guides/">All guides</a></li>
        <li><a href="/faqs/">FAQs</a></li>
      </ul>
    </div>
    <div class="footer-contact">
      <p class="footer-label">Example contact</p>
      <ul class="footer-nav">
        <li><a href="/contact/#enquiry">Enquiry form</a></li>
        <li>
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
          <span class="example-tag">Example number</span>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span class="example-tag">Example address</span>
        </li>
        {
          site.showWhatsApp ? (
            <li>
              <a href={site.whatsappHref} rel="noopener noreferrer">WhatsApp</a>
              <span class="example-tag">Example number</span>
            </li>
          ) : null
        }
      </ul>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>&copy; {new Date().getFullYear()} {site.name}. {site.demoLine}.</p>
  </div>
</footer>
