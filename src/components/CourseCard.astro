---
import type { Course } from "../content/courses";
import { locationsForCourse } from "../lib/catalogue";
import { enquireHref, joinList } from "../lib/links";

interface Props {
  course: Course;
  locationSlug?: string;
}

const { course, locationSlug } = Astro.props;
const placeNames = locationsForCourse(course).map((location) => location.name);
---

<li class="card">
  <p class="card-kicker">{course.sample ? `Sample course · ${course.kicker}` : course.kicker}</p>
  <h3><a href={course.path}>{course.title}</a></h3>
  <p>{course.summary}</p>
  <p class="card-meta">Offered at {joinList(placeNames)}</p>
  <a class="text-link" href={enquireHref({ course: course.id, location: locationSlug })}>Enquire about this course</a>
</li>
