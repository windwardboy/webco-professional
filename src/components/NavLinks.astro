---
import { nav } from "../config/site";
import { isNavCurrent } from "../lib/links";
---

<ul class="nav">
  {
    nav.map((item) => (
      <li>
        <a href={item.href} aria-current={isNavCurrent(Astro.url.pathname, item.href) ? "page" : undefined}>
          {item.label}
        </a>
      </li>
    ))
  }
  <li><a class="button" href="/contact/#enquiry">Enquire now</a></li>
</ul>
