---
import type { Faq } from "../content/types";

interface Props {
  id?: string;
  title?: string;
  intro?: string;
  items: readonly Faq[];
  band?: boolean;
}

const { id = "faq", title = "Questions", intro, items, band = false } = Astro.props;
---

{
  items.length > 0 ? (
    <section class:list={["block", "faq", band && "band"]} aria-labelledby={id}>
      <div class="wrap">
        <div class="section-head">
          <h2 id={id}>{title}</h2>
          {intro ? <p class="section-intro">{intro}</p> : null}
        </div>
        <div class="faq-list">
          {items.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  ) : null
}
