---
import CourseCard from "../../components/CourseCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import FacilityList from "../../components/FacilityList.astro";
import FaqList from "../../components/FaqList.astro";
import LearnerProof from "../../components/LearnerProof.astro";
import MapPlaceholder from "../../components/MapPlaceholder.astro";
import PageHero from "../../components/PageHero.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import TeamCard from "../../components/TeamCard.astro";
import { locations, type TrainingLocation } from "../../content/locations";
import { site } from "../../config/site";
import {
  coursesForLocation,
  facilitiesFor,
  faqsForLocation,
  teamForLocation,
  testimonialsForLocation,
  vehiclesFor,
} from "../../lib/catalogue";
import { enquireHref, pageCrumbs } from "../../lib/links";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return locations
    .filter((location) => location.published)
    .map((location) => ({
      params: { slug: location.slug },
      props: { location },
    }));
}

interface Props {
  location: TrainingLocation;
}

const { location } = Astro.props;
const offered = coursesForLocation(location);
const people = teamForLocation(location);
const proof = testimonialsForLocation(location.id);
const crumbs = pageCrumbs([
  { label: "Locations", href: "/locations/" },
  { label: location.name, href: `/locations/${location.slug}/` },
]);
---

<BaseLayout title={location.metaTitle} description={location.metaDescription} crumbs={crumbs}>
  <PageHero
    crumbs={crumbs}
    eyebrow={location.sample ? `Sample location · ${location.region}` : location.region}
    title={location.name}
    lede={location.summary}
  >
    <div class="actions">
      <a class="button" href={enquireHref({ location: location.slug })}>Enquire about {location.name}</a>
      <a class="button button-quiet" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
    <aside class="glance" slot="aside" aria-label={`Courses at ${location.name}`}>
      <h2>Courses here</h2>
      <ul class="glance-board">
        {
          offered.map((course) => (
            <li>
              <a href={course.path}>
                <span class="glance-title">{course.shortTitle}</span>
                <span class="glance-region">{course.kicker}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </PageHero>

  <section class="block" aria-labelledby="about-site">
    <div class="wrap measure">
      <h2 id="about-site">This base</h2>
      <p>{location.intro}</p>
    </div>
  </section>

  <section class="block band" aria-labelledby="address">
    <div class="wrap">
      <h2 id="address">Getting here</h2>
      <div class="place-grid">
        <div>
          {
            location.addressLines.length > 0 ? (
              <p class="address">
                {location.addressLines.map((line) => (
                  <>
                    {line}
                    <br />
                  </>
                ))}
              </p>
            ) : null
          }
          <h3>Getting there</h3>
          <p>{location.access}</p>
          <h3>Parking</h3>
          <p>{location.parking}</p>
        </div>
        {
          location.image?.src ? (
            <ResponsiveImage image={location.image} sizes="(min-width: 56rem) 32rem, 100vw" />
          ) : (
            <MapPlaceholder />
          )
        }
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="courses-here">
    <div class="wrap">
      <h2 id="courses-here">Courses at {location.name}</h2>
      <p class="measure">The courses we run at {location.name}.</p>
      <ul class="cards">
        {offered.map((course) => <CourseCard course={course} locationSlug={location.slug} />)}
      </ul>
    </div>
  </section>

  <section class="block band" aria-labelledby="facilities">
    <div class="wrap">
      <h2 id="facilities">Facilities and vehicles</h2>
      <FacilityList
        facilities={facilitiesFor(location.facilityIds, location.id)}
        vehicles={vehiclesFor(location.vehicleIds, location.id)}
      />
    </div>
  </section>

  {
    people.length > 0 ? (
      <section class="block" aria-labelledby="instructors">
        <div class="wrap">
          <h2 id="instructors">Instructors</h2>
          <p class="section-intro">The teams who deliver training at this base.</p>
          <ul class="cards">
            {people.map((person) => <TeamCard person={person} />)}
          </ul>
        </div>
      </section>
    ) : null
  }

  <section class="block band" aria-labelledby="local-context">
    <div class="wrap measure">
      <h2 id="local-context">Local knowledge</h2>
      <p>{location.localContext}</p>
    </div>
  </section>

  <LearnerProof id="local-proof" title="Learner feedback" intro={`What learners say about training at ${location.name}.`} items={proof} />
  <FaqList id="location-faq" title={`Questions about ${location.name}`} items={faqsForLocation(location.id)} band={true} />
  <CtaBand
    title={`Ask about training at ${location.name}`}
    lede="Tell us which course you are interested in, and how you would like to be contacted."
    locationSlug={location.slug}
  />
</BaseLayout>
