---
import { courseGroups } from "../content/courses";
import { publishedLocations } from "../content/locations";
import { site } from "../config/site";
import { additionalCourses, coreCourses, hasMultipleLocations } from "../lib/catalogue";
import { enquiryAction } from "../lib/links";

const action = enquiryAction(site.enquiryEndpoint);
const demo = action === null;
const multipleLocations = hasMultipleLocations();
const groups = [
  { ...courseGroups[0], courses: coreCourses() },
  { ...courseGroups[1], courses: additionalCourses() },
];
const onlyLocation = publishedLocations()[0];
---

<form
  id="enquiry-form"
  class="enquiry-form"
  data-enquiry-form
  data-demo={demo ? "true" : "false"}
  method={demo ? "dialog" : "post"}
  action={action ?? undefined}
  aria-describedby={demo ? "enquiry-demo-note" : "enquiry-privacy-note"}
>
  <div class="field">
    <label for="enquiry-name">Name <span class="req">Required</span></label>
    <input id="enquiry-name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="field-row">
    <div class="field">
      <label for="enquiry-phone">Phone <span class="req" data-phone-req>Optional</span></label>
      <input
        id="enquiry-phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        pattern="[+0-9() -]{10,30}"
        title="Use digits, spaces, brackets and a leading + only."
      />
    </div>
    <div class="field">
      <label for="enquiry-email">Email <span class="req">Required</span></label>
      <input id="enquiry-email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="enquiry-course">Course interest <span class="req">Required</span></label>
      <select id="enquiry-course" name="course" required>
        <option value="" selected disabled>Choose a course</option>
        {
          groups.map((group) =>
            group.courses.length > 0 ? (
              <optgroup label={group.label}>
                {group.courses.map((course) => (
                  <option value={course.id}>{course.title}</option>
                ))}
              </optgroup>
            ) : null,
          )
        }
        <option value="not-sure">Not sure yet</option>
      </select>
    </div>
    {
      multipleLocations ? (
        <div class="field">
          <label for="enquiry-location">Preferred base <span class="req">Required</span></label>
          <select id="enquiry-location" name="location" required>
            <option value="" selected disabled>Choose a base</option>
            {publishedLocations().map((location) => (
              <option value={location.slug}>{location.name}</option>
            ))}
            <option value="no-preference">No preference yet</option>
          </select>
        </div>
      ) : onlyLocation ? (
        <input type="hidden" name="location" value={onlyLocation.slug} />
      ) : null
    }
  </div>
  <fieldset class="contact-method">
    <legend>Preferred contact method <span class="req">Required</span></legend>
    <label class="choice">
      <input type="radio" name="contact_method" value="phone" required />
      Phone
    </label>
    <label class="choice">
      <input type="radio" name="contact_method" value="email" />
      Email
    </label>
    {
      site.showWhatsApp ? (
        <label class="choice">
          <input type="radio" name="contact_method" value="whatsapp" />
          WhatsApp
        </label>
      ) : null
    }
  </fieldset>
  <div class="field">
    <label for="enquiry-message">Message <span class="req">Required</span></label>
    <textarea id="enquiry-message" name="message" required></textarea>
  </div>
  {
    demo ? (
      <p id="enquiry-demo-note" class="form-note">
        This demonstration form does not send messages. Nothing you type is stored. See the <a href="/privacy/" rel="privacy-policy">privacy policy</a>.
      </p>
    ) : (
      <p id="enquiry-privacy-note" class="form-note">
        Read the <a href="/privacy/" rel="privacy-policy">privacy policy</a> before you send this form.
      </p>
    )
  }
  {
    demo ? (
      <p class="form-result" data-enquiry-result role="status" hidden tabindex="-1">
        This is a demonstration. Your enquiry was not sent.
      </p>
    ) : null
  }
  <div class="form-actions">
    <button class="button" type="submit">Send enquiry</button>
  </div>
</form>

<script>
  document.querySelectorAll("[data-enquiry-form]").forEach((node) => {
    if (!(node instanceof HTMLFormElement)) return;
    const form = node;
    const params = new URLSearchParams(location.search);
    const phone = form.querySelector("#enquiry-phone");
    const name = form.querySelector("#enquiry-name");
    const message = form.querySelector("#enquiry-message");
    const phoneReq = form.querySelector("[data-phone-req]");

    const selectValue = (field: string, value: string | null) => {
      const select = form.querySelector(`select[name='${field}']`);
      if (!value || !(select instanceof HTMLSelectElement)) return;
      if ([...select.options].some((option) => option.value === value)) {
        select.value = value;
      }
    };

    selectValue("course", params.get("course"));
    selectValue("location", params.get("location"));

    const selectedMethod = () => {
      const picked = form.querySelector("input[name='contact_method']:checked");
      return picked instanceof HTMLInputElement ? picked.value : "";
    };

    const phoneError = (value: string, method: string) => {
      const trimmed = value.trim();
      const needsPhone = method === "phone" || method === "whatsapp";
      if (trimmed === "") {
        if (!needsPhone) return "";
        return method === "whatsapp" ? "Enter the number to use on WhatsApp." : "Enter a phone number.";
      }
      if (!/^[+0-9() -]+$/.test(trimmed)) return "Use digits, spaces, brackets and a leading + only.";
      const digits = trimmed.replace(/\D/g, "").length;
      if (digits < 10 || digits > 15) return "Enter a phone number with 10 to 15 digits.";
      return "";
    };

    const syncPhone = () => {
      if (!(phone instanceof HTMLInputElement)) return;
      const method = selectedMethod();
      const needsPhone = method === "phone" || method === "whatsapp";
      phone.required = needsPhone;
      phone.setCustomValidity(phoneError(phone.value, method));
      if (phoneReq) phoneReq.textContent = needsPhone ? "Required" : "Optional";
    };

    form.addEventListener("change", (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement && target.name === "contact_method") syncPhone();
    });

    form.addEventListener("input", (event) => {
      const target = event.target;
      if (target === phone && phone instanceof HTMLInputElement) {
        const method = selectedMethod();
        const needsPhone = method === "phone" || method === "whatsapp";
        phone.required = needsPhone;
        if (phoneReq) phoneReq.textContent = needsPhone ? "Required" : "Optional";
        if (phoneError(phone.value, method) === "") phone.setCustomValidity("");
        return;
      }
      if (target === name && name instanceof HTMLInputElement) {
        if (name.value.trim() !== "") name.setCustomValidity("");
      }
      if (target === message && message instanceof HTMLTextAreaElement) {
        if (message.value.trim() !== "") message.setCustomValidity("");
      }
    });

    form.addEventListener("submit", (event) => {
      const result = form.querySelector("[data-enquiry-result]");
      if (result instanceof HTMLElement) result.hidden = true;
      syncPhone();
      if (name instanceof HTMLInputElement) {
        name.setCustomValidity(name.value.trim() === "" ? "Enter your name." : "");
      }
      if (message instanceof HTMLTextAreaElement) {
        message.setCustomValidity(message.value.trim() === "" ? "Enter a message." : "");
      }
      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        return;
      }
      if (form.dataset.demo !== "true") return;
      event.preventDefault();
      if (result instanceof HTMLElement) {
        result.hidden = false;
        result.focus();
      }
    });
  });
</script>
