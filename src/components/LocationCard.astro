---
import type { TrainingLocation } from "../content/locations";
import { coursesForLocation } from "../lib/catalogue";
import { enquireHref, joinList } from "../lib/links";

interface Props {
  location: TrainingLocation;
  courseId?: string;
}

const { location, courseId } = Astro.props;
const courseNames = coursesForLocation(location).map((course) => course.shortTitle);
---

<li class="card">
  <p class="card-kicker">{location.sample ? `Example location · ${location.region}` : location.region}</p>
  <h3><a href={`/locations/${location.slug}/`}>{location.name}</a></h3>
  <p>{location.summary}</p>
  <p class="card-meta">{joinList(courseNames)}</p>
  <a class="text-link" href={enquireHref({ course: courseId, location: location.slug })}>Enquire about this location</a>
</li>
