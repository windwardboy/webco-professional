---
import CourseCard from "../../components/CourseCard.astro";
import PageHero from "../../components/PageHero.astro";
import { courseGroups } from "../../content/courses";
import { coursesInCategory } from "../../lib/catalogue";
import BaseLayout from "../../layouts/BaseLayout.astro";

const groups = courseGroups
  .map((group) => ({ group, items: coursesInCategory(group.id) }))
  .filter((entry) => entry.items.length > 0);
---

<BaseLayout
  title="Courses"
  description="Sample HGV courses on the Webco Professional demonstration. Each course has its own page and lists the locations where it is offered."
>
  <PageHero
    eyebrow="Sample catalogue"
    title="Courses"
    lede="A page for each course, grouped so a longer list stays easy to scan. Not every course runs at every site."
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Courses" },
    ]}
  />
  <div class="block block-follow">
    <div class="wrap">
      <nav aria-label="Course groups">
        <ul class="course-jump">
          {
            groups.map(({ group }) => (
              <li>
                <a href={`#${group.id}`}>{group.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      {
        groups.map(({ group, items }) => (
          <section class="catalogue" id={group.id} aria-labelledby={`${group.id}-heading`}>
            <div class="section-head section-head-split">
              <h2 id={`${group.id}-heading`}>{group.label}</h2>
              <p class="section-intro">{group.intro}</p>
            </div>
            <ul class="cards">
              {items.map((course) => (
                <CourseCard course={course} />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
