---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page is not on this Webco Professional demonstration site." noindex={true}>
  <section class="hero missing">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not here</h1>
      <p class="lede">The link may be out of date. Training, locations, guides and the enquiry form are still available.</p>
      <div class="actions">
        <a class="button" href="/">Back to the homepage</a>
        <a class="button button-quiet" href="/training/">View training</a>
        <a class="button button-text" href="/locations/">View locations</a>
      </div>
    </div>
  </section>
</BaseLayout>
