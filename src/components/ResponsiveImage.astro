---
import type { ContentImage } from "../content/types";

interface Props {
  image: ContentImage;
  sizes?: string;
}

const { image, sizes = "(min-width: 56rem) 38vw, 100vw" } = Astro.props;
---

{
  image.src ? (
    <picture>
      {image.avif ? <source type="image/avif" srcset={image.avif} /> : null}
      {image.webp ? <source type="image/webp" srcset={image.webp} /> : null}
      <img
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        sizes={sizes}
        decoding="async"
      />
    </picture>
  ) : null
}
