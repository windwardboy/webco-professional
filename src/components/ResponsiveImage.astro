---
import type { ContentImage } from "../content/types";

interface Props {
  image: ContentImage;
  sizes?: string;
  /** Above-the-fold image: load immediately and at high priority. */
  priority?: boolean;
}

const { image, sizes = "(min-width: 56rem) 38vw, 100vw", priority = false } = Astro.props;
---

{
  image.src ? (
    <picture>
      {image.avif ? <source type="image/avif" srcset={image.avif} /> : null}
      {image.webp ? <source type="image/webp" srcset={image.webp} /> : null}
      <img
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        sizes={sizes}
        decoding={priority ? "sync" : "async"}
        loading={priority ? "eager" : undefined}
        fetchpriority={priority ? "high" : undefined}
      />
    </picture>
  ) : null
}
