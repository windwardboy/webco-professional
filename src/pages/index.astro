---
import CtaBand from "../components/CtaBand.astro";
import CourseCard from "../components/CourseCard.astro";
import FaqList from "../components/FaqList.astro";
import FacilityList from "../components/FacilityList.astro";
import GuideCard from "../components/GuideCard.astro";
import LearnerProof from "../components/LearnerProof.astro";
import LocationCard from "../components/LocationCard.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import RouteSelector from "../components/RouteSelector.astro";
import Section from "../components/Section.astro";
import TeamCard from "../components/TeamCard.astro";
import TrustStrip from "../components/TrustStrip.astro";
import { facilities } from "../content/facilities";
import { homepage } from "../content/homepage";
import { trainingJourney } from "../content/process";
import { trustPoints } from "../content/trust";
import { vehicles } from "../content/vehicles";
import { site } from "../config/site";
import {
  additionalCourses,
  coreCourses,
  featuredGuides,
  homeFaqs,
  publishedLocations,
  testimonials,
  visibleTeam,
} from "../lib/catalogue";
import BaseLayout from "../layouts/BaseLayout.astro";

const image = site.heroImage;
---

<BaseLayout
  title="HGV training in Bristol, Taunton and Exeter"
  description="Category C and Category C+E licence training, plus Driver CPC, ADR and Operator CPC courses, from training bases in Bristol, Taunton and Exeter. Enquire online or by phone."
>
  <section class:list={["hero", image.src && "has-media"]}>
    {
      image.src ? (
        <div class="hero-media">
          <ResponsiveImage image={image} sizes="100vw" priority={true} />
        </div>
      ) : null
    }
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{homepage.eyebrow}</p>
        <h1>{homepage.title}</h1>
        <p class="lede">{homepage.lede}</p>
        <div class="actions">
          <a class="button" href="/contact/#enquiry">Enquire now</a>
          <a class="button button-quiet" href={site.phoneHref}>Call {site.phoneDisplay}</a>
          <a class="button button-text" href="/hgv-training/">HGV training</a>
        </div>
        <p class="example-caption">{homepage.exampleNote}</p>
      </div>
    </div>
  </section>

  <TrustStrip />

  <RouteSelector title={homepage.routesTitle} intro={homepage.routesIntro} band={true} />

  <Section id="core" title={homepage.coreTitle} intro={homepage.coreIntro}>
    <ul class="cards">
      {coreCourses().map((course) => <CourseCard course={course} />)}
    </ul>
    <p class="section-more"><a href="/hgv-training/">Compare the HGV routes</a></p>
  </Section>

  <Section id="further" title={homepage.furtherTitle} intro={homepage.furtherIntro} band={true}>
    <ul class="cards">
      {additionalCourses().map((course) => <CourseCard course={course} />)}
    </ul>
    <p class="section-more"><a href="/training/">View all training</a></p>
  </Section>

  <Section id="why" title={homepage.whyTitle} intro={homepage.whyIntro} dark={true}>
    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <ProcessSteps id="how" title={homepage.howTitle} intro={homepage.howIntro} steps={trainingJourney} />

  <Section id="locations" title={homepage.locationsTitle} intro={homepage.locationsIntro} band={true}>
    <ul class="cards">
      {publishedLocations().map((location) => <LocationCard location={location} />)}
    </ul>
  </Section>

  <LearnerProof title={homepage.proofTitle} intro={homepage.proofIntro} items={testimonials} />
  <p class="wrap section-more"><a href="/reviews/">Read more learner feedback</a></p>

  <Section id="operations" title={homepage.operationsTitle} intro={homepage.operationsIntro} band={true}>
    <ul class="cards">
      {visibleTeam().map((person) => <TeamCard person={person} />)}
    </ul>
    <FacilityList vehicles={vehicles} facilities={facilities} />
    <p class="section-more"><a href="/team/">Instructors and team</a></p>
  </Section>

  <Section id="guides" title={homepage.guidesTitle} intro={homepage.guidesIntro}>
    <ul class="cards">
      {featuredGuides().map((guide) => <GuideCard guide={guide} />)}
    </ul>
    <p class="section-more"><a href="/guides/">All guides</a></p>
  </Section>

  <FaqList title={homepage.faqTitle} items={homeFaqs()} band={true} />
  <CtaBand title={homepage.ctaTitle} lede={homepage.ctaLede} />
</BaseLayout>
