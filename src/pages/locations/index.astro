---
import CtaBand from "../../components/CtaBand.astro";
import LocationCard from "../../components/LocationCard.astro";
import PageHero from "../../components/PageHero.astro";
import { publishedLocations } from "../../lib/catalogue";
import { pageCrumbs } from "../../lib/links";
import BaseLayout from "../../layouts/BaseLayout.astro";

const crumbs = pageCrumbs([{ label: "Locations", href: "/locations/" }]);
const places = publishedLocations();
---

<BaseLayout
  title="Training locations"
  description="HGV training bases at Bristol, Taunton and Exeter. Each base page lists the courses offered there and how to enquire."
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Our bases"
    title="Training locations"
    lede="Three training bases across Bristol, Somerset and Devon. Each card shows the courses you can take at that base."
  />
  <div class="block block-follow">
    <div class="wrap">
      <ul class="cards">
        {places.map((location) => <LocationCard location={location} />)}
      </ul>
    </div>
  </div>
  <CtaBand
    title="Ask about a base"
    lede={places.length > 1 ? "Choose the base you prefer, and the course you want." : "Ask about training at this base."}
  />
</BaseLayout>
