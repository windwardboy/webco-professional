---
import CtaBand from "./CtaBand.astro";
import FacilityList from "./FacilityList.astro";
import FaqList from "./FaqList.astro";
import LearnerProof from "./LearnerProof.astro";
import LocationCard from "./LocationCard.astro";
import PageHero from "./PageHero.astro";
import ProcessSteps from "./ProcessSteps.astro";
import RelatedLinks from "./RelatedLinks.astro";
import Section from "./Section.astro";
import TeamCard from "./TeamCard.astro";
import type { Course } from "../content/courses";
import { trustPoints } from "../content/trust";
import { site } from "../config/site";
import {
  facilitiesFor,
  faqsForCourse,
  locationsForCourse,
  relatedCourses,
  relatedGuides,
  teamForCourse,
  testimonialsFor,
  vehiclesFor,
} from "../lib/catalogue";
import { enquireHref, pageCrumbs } from "../lib/links";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  course: Course;
}

const { course } = Astro.props;
const places = locationsForCourse(course);
const people = teamForCourse(course);
const proof = testimonialsFor(course.testimonialIds);
const courseFaqs = faqsForCourse(course.id);
const vehicles = vehiclesFor(course.vehicleIds);
const facilityItems = facilitiesFor(course.facilityIds);
const durationText =
  course.duration ||
  (course.kind === "licence"
    ? "How long training takes depends on the licence you already hold and your experience in this type of vehicle. We confirm it when you enquire."
    : "We confirm the length of the course and the next available dates when you enquire.");
const priceText =
  course.priceNote ||
  (course.kind === "licence"
    ? "We quote once we know the licence you hold and the training you need. Medicals, theory tests and the practical test are separate costs where they apply."
    : "We confirm the fee when you enquire, along with the dates available.");
const crumbs = pageCrumbs([
  course.group === "core"
    ? { label: "HGV training", href: "/hgv-training/" }
    : { label: "Training", href: "/training/" },
  { label: course.navLabel, href: course.path },
]);
const jumpLinks = [
  { id: "explanation", label: "Overview" },
  { id: "who", label: "Who it is for" },
  { id: "permits", label: "What it covers" },
  { id: "eligibility", label: "Eligibility" },
  { id: "includes", label: "Training" },
  { id: "process", label: "How it works" },
  { id: "cost", label: "Duration and cost" },
  { id: "locations", label: "Locations" },
  ...(people.length > 0 ? [{ id: "instructors", label: "Instructors" }] : []),
  ...(courseFaqs.length > 0 ? [{ id: "course-faq", label: "Questions" }] : []),
];
---

<BaseLayout title={course.metaTitle} description={course.metaDescription} crumbs={crumbs}>
  <PageHero
    crumbs={crumbs}
    eyebrow={course.sample ? `Sample course · ${course.kicker}` : course.kicker}
    title={course.metaTitle}
    lede={course.summary}
  >
    <div class="actions">
      <a class="button" href={enquireHref({ course: course.id })}>Enquire about {course.title}</a>
      <a class="button button-quiet" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
    <aside class="glance" slot="aside" aria-label="Where this course runs">
      <h2>Offered at</h2>
      <ul class="glance-board">
        {
          places.map((location) => (
            <li>
              <a href={`/locations/${location.slug}/`}>
                <span class="glance-title">{location.name}</span>
                <span class="glance-region">{location.region}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </PageHero>

  <nav class="subnav" aria-label="On this page">
    <ul class="wrap subnav-list">
      {jumpLinks.map((link) => <li><a href={`#${link.id}`}>{link.label}</a></li>)}
    </ul>
  </nav>

  <Section id="explanation" title="In plain English" narrow={true}>
    <p>{course.explanation}</p>
  </Section>

  <Section id="who" title="Who it is for" intro={course.audience} band={true} narrow={true} />

  <Section id="permits" title="What it covers" narrow={true}>
    <ul class="prose-list">
      {course.permits.map((item) => <li>{item}</li>)}
    </ul>
    <p>{course.permitsNote}</p>
  </Section>

  <Section id="eligibility" title="Eligibility and prerequisites" intro="A general guide. We check your own licence when you enquire." band={true} narrow={true}>
    <ul class="prose-list">
      {course.eligibility.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <Section id="includes" title="What the training includes" narrow={true}>
    <ul class="prose-list">
      {course.includes.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <ProcessSteps id="process" title="How the course works" steps={course.steps} band={true} />

  <Section id="format" title="Training format" intro={course.format} narrow={true} />

  <Section id="cost" title="Duration and cost" band={true} narrow={true}>
    <p>{durationText}</p>
    <p>{priceText}</p>
  </Section>

  <Section id="locations" title="Where this course runs" intro="This course runs at the bases below. Each one has its own page.">
    <ul class="cards">
      {places.map((location) => <LocationCard location={location} courseId={course.id} />)}
    </ul>
  </Section>

  <Section id="why" title="Why train here" dark={true}>
    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    vehicles.length > 0 || facilityItems.length > 0 ? (
      <Section id="operations" title="Vehicles and facilities">
        <FacilityList vehicles={vehicles} facilities={facilityItems} />
      </Section>
    ) : null
  }

  {
    people.length > 0 ? (
      <Section id="instructors" title="Instructors" intro="The team who deliver this course." band={true}>
        <ul class="cards">
          {people.map((person) => <TeamCard person={person} />)}
        </ul>
      </Section>
    ) : null
  }

  <LearnerProof id="learner" title="Learner feedback" intro="What learners say about this course." items={proof} />
  <FaqList id="course-faq" title="Questions about this course" items={courseFaqs} band={true} />
  <RelatedLinks courses={relatedCourses(course)} guides={relatedGuides(course)} />
  <CtaBand
    title={`Ask about ${course.title}`}
    lede="Tell us which base you prefer, and how you would like to be contacted."
    courseSlug={course.id}
  />
</BaseLayout>
