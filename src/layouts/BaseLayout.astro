---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../config/site";
import "../lib/catalogue";
import { analyticsMeasurementId, canonicalUrl, jsonLd, type Crumb } from "../lib/links";
import "@fontsource-variable/public-sans/wght.css";
import "@fontsource-variable/source-serif-4/wght.css";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  crumbs?: readonly Crumb[];
}

const { title, description, noindex = false, crumbs = [] } = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const canonical = canonicalUrl(Astro.url.pathname);
const analyticsId = analyticsMeasurementId(site.analyticsId);
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description: site.description,
};
const breadcrumb =
  crumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: crumbs.map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: crumb.label,
          item: canonicalUrl(crumb.href),
        })),
      }
    : null;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2f28" />
    {noindex && <meta name="robots" content="noindex" />}
    {
      site.googleSiteVerification ? (
        <meta name="google-site-verification" content={site.googleSiteVerification} />
      ) : null
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <script type="application/ld+json" set:html={jsonLd(website)} />
    {breadcrumb ? <script type="application/ld+json" set:html={jsonLd(breadcrumb)} /> : null}
    {
      /* Rendered only when analyticsId is a GA4 id. It is empty here, so the tag is omitted.
         Do not set an id until a consent step gates this script. */
      analyticsId ? (
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`} />
      ) : null
    }
    {
      analyticsId ? (
        <script is:inline define:vars={{ analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", analyticsId);
        </script>
      ) : null
    }
  </head>
  <body class="site-professional">
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
